{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "entrypoints/**",
      "lib/**",
      "*.ts",
      "*.json",
      "!!**/legacy",
      "!!**/.wxt",
      "!!**/.output",
      "!!**/node_modules"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "noLabelWithoutControl": "off" }
    }
  }
}
